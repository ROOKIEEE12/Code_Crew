 "components": {
  "schemas": {
   "AcceptanceCriterion": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id",
      "description": "Short id: AC1, AC2, ..."
     },
     "description": {
      "type": "string",
      "title": "Description",
      "description": "One observable, checkable behaviour."
     },
     "verification": {
      "type": "string",
      "enum": [
       "automated_test",
       "static_check",
       "manual"
      ],
      "title": "Verification"
     }
    },
    "type": "object",
    "required": [
     "id",
     "description",
     "verification"
    ],
    "title": "AcceptanceCriterion"
   },
   "ActivityEntry": {
    "properties": {
     "ts": {
      "type": "number",
      "title": "Ts"
     },
     "agent": {
      "type": "string",
      "title": "Agent"
     },
     "message": {
      "type": "string",
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "agent",
     "message"
    ],
    "title": "ActivityEntry"
   },
   "AnswerBody": {
    "properties": {
     "question_id": {
      "type": "string",
      "maxLength": 32,
      "minLength": 1,
      "title": "Question Id"
     },
     "choice": {
      "type": "integer",
      "maximum": 9.0,
      "minimum": 0.0,
      "title": "Choice"
     }
    },
    "type": "object",
    "required": [
     "question_id",
     "choice"
    ],
    "title": "AnswerBody"
   },
   "Clarification": {
    "properties": {
     "question": {
      "type": "string",
      "title": "Question"
     },
     "answer": {
      "type": "string",
      "title": "Answer"
     },
     "auto": {
      "type": "boolean",
      "title": "Auto",
      "default": false
     }
    },
    "type": "object",
    "required": [
     "question",
     "answer"
    ],
    "title": "Clarification"
   },
   "ColorToken": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name",
      "description": "Role of the colour, e.g. 'background', 'surface', 'text', 'muted', 'accent'."
     },
     "hex": {
      "type": "string",
      "title": "Hex",
      "description": "Hex value, e.g. '#0b0b0f'."
     },
     "usage": {
      "type": "string",
      "title": "Usage",
      "description": "Where it is used."
     }
    },
    "type": "object",
    "required": [
     "name",
     "hex",
     "usage"
    ],
    "title": "ColorToken"
   },
   "CreateRun": {
    "properties": {
     "requirement": {
      "type": "string",
      "maxLength": 8000,
      "minLength": 3,
      "title": "Requirement"
     },
     "ask": {
      "type": "boolean",
      "title": "Ask",
      "description": "Let the Planner ask up to 2 multiple-choice questions before planning.",
      "default": false
     },
     "images": {
      "items": {
       "$ref": "#/components/schemas/ImageIn"
      },
      "type": "array",
      "maxItems": 4,
      "title": "Images",
      "description": "Reference designs (screenshots) for vision-capable models."
     }
    },
    "type": "object",
    "required": [
     "requirement"
    ],
    "title": "CreateRun"
   },
   "DebugRound": {
    "properties": {
