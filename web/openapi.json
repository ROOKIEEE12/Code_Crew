 "components": {
  "schemas": {
   "AcceptanceCriterion": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id",
      "description": "Short id: AC1, AC2, ..."
     },
     "description": {
      "type": "string",
      "title": "Description",
      "description": "One observable, checkable behaviour."
     },
     "verification": {
      "type": "string",
      "enum": [
       "automated_test",
       "static_check",
       "manual"
      ],
      "title": "Verification"
     }
    },
    "type": "object",
    "required": [
     "id",
     "description",
     "verification"
    ],
    "title": "AcceptanceCriterion"
   },
   "ActivityEntry": {
    "properties": {
     "ts": {
      "type": "number",
      "title": "Ts"
     },
     "agent": {
      "type": "string",
      "title": "Agent"
     },
     "message": {
      "type": "string",
      "title": "Message"
     }
    },
    "type": "object",
    "required": [
     "agent",
     "message"
    ],
    "title": "ActivityEntry"
   },
   "CreateRun": {
    "properties": {
     "requirement": {
      "type": "string",
      "maxLength": 8000,
      "minLength": 3,
      "title": "Requirement"
     }
    },
    "type": "object",
    "required": [
     "requirement"
    ],
    "title": "CreateRun"
   },
   "DebugRound": {
    "properties": {
     "round": {
      "type": "integer",
      "title": "Round"
     },
     "targeted_issues": {
      "type": "integer",
      "title": "Targeted Issues"
     },
     "changed_files": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Changed Files"
     },
     "disputes": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Disputes",
      "default": []
     },
     "score_before": {
      "items": {
       "type": "integer"
      },
      "type": "array",
      "title": "Score Before"
     },
     "score_after": {
      "anyOf": [
       {
        "items": {
         "type": "integer"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Score After"
     },
     "kept": {
      "type": "boolean",
      "title": "Kept",
      "default": true
     }
    },
    "type": "object",
    "required": [
     "round",
     "targeted_issues",
     "changed_files",
     "score_before"
    ],
    "title": "DebugRound"
   },
   "FileCheck": {
    "properties": {
     "status": {
      "type": "string",
      "enum": [
       "passed",
       "failed",
       "unchecked"
      ],
      "title": "Status"
     },
     "tool": {
      "type": "string",
      "title": "Tool",
      "default": ""
     },
     "output": {
      "type": "string",
      "title": "Output",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "status"
    ],
    "title": "FileCheck"
   },
   "FileSpec": {
    "properties": {
     "path": {
      "type": "string",
      "title": "Path",
      "description": "Relative POSIX path inside the project, e.g. 'src/app.py'."
     },
     "language": {
      "type": "string",
      "enum": [
       "python",
       "javascript",
       "typescript",
       "html",
       "css",
       "json",
       "markdown",
       "text"
      ],
      "title": "Language"
     },
     "purpose": {
      "type": "string",
      "title": "Purpose"
     },
     "depends_on": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Depends On",
      "description": "Other planned file paths this file must stay consistent with."
     },
     "functions": {
      "items": {
       "$ref": "#/components/schemas/FunctionSpec"
      },
      "type": "array",
      "title": "Functions",
      "description": "Public functions/classes. Empty for markup/style files."
     },
     "testable": {
      "type": "boolean",
      "title": "Testable",
      "description": "True if this file exposes importable logic that unit tests can call."
     }
    },
    "type": "object",
    "required": [
     "path",
     "language",
     "purpose",
     "depends_on",
     "functions",
     "testable"
    ],
    "title": "FileSpec"
   },
   "FunctionSpec": {
    "properties": {
     "name": {
      "type": "string",
      "title": "Name",
      "description": "Exact function/class name, as it will be imported by tests."
     },
     "signature": {
      "type": "string",
      "title": "Signature",
      "description": "Full signature, e.g. 'def add(a: int, b: int) -> int'."
     },
     "behavior": {
      "type": "string",
      "title": "Behavior",
      "description": "What it does, including inputs, outputs and return values."
     },
     "edge_cases": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Edge Cases",
      "description": "Edge cases and errors it must handle, e.g. 'raises ValueError on negative n'."
     }
    },
    "type": "object",
    "required": [
     "name",
     "signature",
     "behavior",
     "edge_cases"
    ],
    "title": "FunctionSpec"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Issue": {
    "properties": {
     "source": {
      "type": "string",
      "enum": [
       "syntax",
       "contract",
       "test",
       "lint",
       "security",
       "spec"
      ],
      "title": "Source"
     },
     "severity": {
      "type": "string",
      "enum": [
       "error",
       "warning"
      ],
      "title": "Severity"
     },
     "file": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "File"
     },
     "line": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Line"
     },
     "message": {
      "type": "string",
      "title": "Message"
     },
     "test_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Test Id"
     }
    },
    "type": "object",
    "required": [
     "source",
     "severity",
     "message"
    ],
    "title": "Issue"
   },
   "IterateRun": {
    "properties": {
     "request": {
      "type": "string",
      "maxLength": 8000,
      "minLength": 3,
      "title": "Request"
     }
    },
    "type": "object",
    "required": [
     "request"
    ],
    "title": "IterateRun"
   },
   "RunState": {
    "properties": {
     "id": {
      "type": "string",
      "title": "Id"
     },
     "mode": {
      "type": "string",
      "enum": [
       "build",
       "iterate"
      ],
      "title": "Mode",
      "default": "build"
     },
     "requirement": {
      "type": "string",
      "title": "Requirement"
     },
     "project_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Project Id"
     },
     "status": {
      "type": "string",
      "enum": [
       "queued",
       "running",
       "succeeded",
       "failed",
       "cancelled",
       "error"
      ],
      "title": "Status",
      "default": "queued"
     },
     "phase": {
      "type": "string",
      "title": "Phase",
      "default": "queued"
     },
     "spec": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/SpecOut"
       },
       {
        "type": "null"
       }
      ]
     },
     "triage": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/TriageOut"
       },
       {
        "type": "null"
       }
      ]
     },
     "files": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Files",
      "default": {}
     },
     "tests": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object",
      "title": "Tests",
      "default": {}
     },
     "verification": {
      "anyOf": [
       {
        "$ref": "#/components/schemas/Verification"
       },
       {
        "type": "null"
       }
      ]
     },
     "best_round": {
      "type": "integer",
      "title": "Best Round",
      "default": 0
     },
     "debug_rounds": {
      "items": {
       "$ref": "#/components/schemas/DebugRound"
      },
      "type": "array",
      "title": "Debug Rounds",
      "default": []
     },
     "disputes_used": {
      "type": "integer",
      "title": "Disputes Used",
      "default": 0
     },
     "readme": {
      "type": "string",
      "title": "Readme",
      "default": ""
     },
     "activity": {
      "items": {
       "$ref": "#/components/schemas/ActivityEntry"
      },
      "type": "array",
      "title": "Activity",
      "default": []
     },
     "usage": {
      "$ref": "#/components/schemas/Usage",
      "default": {
       "calls": 0,
       "input_tokens": 0,
       "output_tokens": 0,
       "by_model": {}
      }
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "project_dir": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Project Dir"
     },
     "created_at": {
      "type": "number",
      "title": "Created At"
     },
     "finished_at": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Finished At"
     }
    },
    "type": "object",
    "required": [
     "id",
     "requirement"
    ],
    "title": "RunState"
   },
   "SpecOut": {
    "properties": {
     "project_name": {
      "type": "string",
      "title": "Project Name",
      "description": "short-kebab-case-name"
     },
     "project_type": {
      "type": "string",
      "enum": [
       "script",
       "cli_tool",
       "web_app",
       "backend_api",
       "library",
       "other"
      ],
      "title": "Project Type"
     },
     "summary": {
      "type": "string",
