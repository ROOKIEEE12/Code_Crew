# ====================================================================
# Git Ignore - CodeCrew
# Ensures secrets, environments, builds, and caches are NEVER committed
# ====================================================================

# Secrets & Environment variables (CRITICAL)
.env
.env.*
!.env.example
*.key
*.pem
*.secret
credentials.json
token.json

# Python Virtual Environments
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/

# Node & Frontend dependencies and builds
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
.eslintcache
dist/
build/

# Generated Outputs & Temporary files
generated_projects/*
!generated_projects/.gitkeep

# IDEs & OS Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
