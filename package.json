{
  "name": "codecrew-workspace",
  "version": "3.0.0",
  "description": "CodeCrew: a multi-agent AI system for collaborative software development",
  "private": true,
  "scripts": {
    "dev": "python scripts/dev.py",
    "server": "python server.py",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "gen:api": "npm --prefix web run gen:api",
    "test": "python -m pytest tests",
    "eval": "python -m eval.run",
    "ext:build": "npm --prefix vscode-extension run build"
  },
  "license": "MIT"
}
