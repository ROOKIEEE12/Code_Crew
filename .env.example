# CodeCrew Environment Configuration
# Copy this file to .env and insert your real API key(s)
# DO NOT commit your real .env file with secrets to Git or GitHub!

# Google Gemini API Key (Required for default engine)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use
GEMINI_MODEL=gemini-2.5-flash

# Optional: Anthropic Claude / OpenAI keys if multi-provider is enabled
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Pipeline Configuration
MAX_DEBUG_RETRIES=3
MAX_PARALLEL_WORKERS=4
OUTPUT_DIR=generated_projects
