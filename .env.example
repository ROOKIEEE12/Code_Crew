# --- LLM providers (tried in LLM_PROVIDERS order; any without a key is skipped) ---
# Most accurate: Claude. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5          # default; per-role override e.g. ANTHROPIC_MODEL_REVIEWER=claude-haiku-5-5

# Free fallbacks
OPENROUTER_API_KEY=                        # https://openrouter.ai/keys
# OPENROUTER_MODELS=poolside/laguna-s-2.1:free,nvidia/nemotron-3.5-lightning:free,openrouter/free
GEMINI_API_KEY=                            # comma-separate several keys to rotate
# GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash

# LLM_PROVIDERS=anthropic,openrouter,gemini

# --- Models per role (optional) ---
# Put the strongest model where quality is decided (planner, coder, debugger, design_review)
# and a cheaper one where it is not (reviewer, clarifier, triage). Roles: clarifier, planner,
# test_author, coder, debugger, reviewer, design_review, triage.
# Claude (best results for code and design):
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_MODEL_REVIEWER=claude-haiku-5-5
# ANTHROPIC_MODEL_CLARIFIER=claude-haiku-5-5
# Gemini / OpenRouter: a comma-separated list per role, tried in order, e.g.
# GEMINI_MODELS_CODER=<a Pro model your key can use>,gemini-3.5-flash
# GEMINI_MODELS_PLANNER=<a Pro model your key can use>,gemini-3.5-flash
# OPENROUTER_MODELS_DESIGN_REVIEW=some/vision-model
# Images (your reference screenshots, page screenshots for the design review) need a model
# that can see images: Claude and Gemini models can; many free OpenRouter models cannot.

# --- Reliability ---
# LLM_TIMEOUT_SEC=300                      # longest wait for one AI response, then the next model is tried
# MODEL_STRIKES=2                          # a model that times out / gives unusable output this often is skipped for the run
# MAX_MODEL_WAIT_SEC=300                   # when every model is rate-limited, wait up to this long instead of failing

# --- Design quality ---
# READ_LINKS=1                             # read links in a request (reference websites) and give them to the agents
# BROWSER_CHECKS=auto                      # open web pages in headless Chromium: JS errors, phone layout (auto|on|off)
# DESIGN_REVIEW_ROUNDS=2                   # screenshot review + polish rounds after the tests pass (0 = off)
# DESIGN_REVIEW_PASS=8                     # a review scoring at least this (1-10) needs no polish
# Browser checks, reference screenshots and the design review need Playwright:
#   pip install playwright && python -m playwright install chromium

# --- Pipeline ---
# MAX_DEBUG_ROUNDS=4
# MAX_TEST_DISPUTES=3
# TEST_TIMEOUT_SEC=60
# RUN_TIMEOUT_SEC=20                       # longest a program started with the Run button may run
# QUESTION_TIMEOUT_SEC=60                 # how long the Planner waits for your answer before using the recommended option
# CLARIFY_MAX_CHARS=400                    # requests at least this long skip the questions (already detailed)
# SANDBOX=process                          # or "docker" (build once: docker build -t codecrew-sandbox sandbox)

# --- Server ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OUTPUT_DIR=generated_projects
